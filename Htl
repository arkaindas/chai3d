export default {
	askQuestion (question) {
		storeValue("q", question);
		return Api1.run().then(function (response) {
			var history = appsmith.store.chatHistory || [];
			history.unshift({
				question: question,
				answer: response.text,
				time: new Date().toLocaleTimeString()
			});
			storeValue("chatHistory", history);
			storeValue("count", (appsmith.store.count || 0) + 1);
		});
	}
}
