var NAME_MAX_LENGTH = 60;

function toSafeName(value) {
  if (typeof value !== 'string') {
    return '';
  }
  return value
    // Invisible/control chars only. ZWNJ (200C) and ZWJ (200D) are
    // deliberately kept — they are meaningful in Bengali, Hindi, Persian.
    .replace(/[\u0000-\u001F\u007F-\u009F\u200B\u200E\u200F\u202A-\u202E\u2060\uFEFF]/g, '')
    .replace(/\s+/g, ' ')
    .replace(/^\s+|\s+$/g, '')
    .substring(0, NAME_MAX_LENGTH);
}
